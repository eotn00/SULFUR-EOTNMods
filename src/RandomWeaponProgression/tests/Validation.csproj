<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <Target Name="CheckGameRoot" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameRoot)' == ''" Text="Pass -p:GameRoot=your_game_directory" />
  </Target>
  <ItemGroup>
    <Compile Include="..\Progression.cs" Link="Progression.cs" />
    <Compile Include="..\WeaponState.cs" Link="WeaponState.cs" />
    <Reference Include="PerfectRandom.Sulfur.Core"><HintPath>$(GameRoot)\Sulfur_Data\Managed\PerfectRandom.Sulfur.Core.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameRoot)\Sulfur_Data\Managed\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(GameRoot)\BepInEx\core\Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
